{
  "useTabs": true,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": {},
  "sortTailwindcss": {},
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/src/routeTree.gen.ts",
    "**/src/styles.css",
    "worker-configuration.d.ts"
  ]
}
